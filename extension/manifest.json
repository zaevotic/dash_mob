{
  "manifest_version": 3,
  "name": "vigild - Send to Dock",
  "version": "1.0.0",
  "description": "Send current YouTube video and playback timestamp directly to your vigild phone dock.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to vigild Dock"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ]
}
